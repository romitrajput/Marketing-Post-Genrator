{
  "name": "remix-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-budget, browser-only computer vision visual remix studio (PoC)",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "fetch-ocr-lang": "node scripts/fetch-ocr-lang.mjs",
    "demos": "python3 scripts/make-demos.py"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.10.0-release.1",
    "fabric": "^6.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.6.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=18.18"
  }
}
